@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using GameHub.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Meus dados pessoais — GameHub</PageTitle>

<StatusMessage />
<h3>Meus dados pessoais</h3>

<p class="pg-muted">
    A LGPD lhe dá dois direitos sobre os dados que guardamos de você: <strong>saber quais são</strong>
    (direito de acesso) e <strong>pedir a exclusão</strong>. Os dois estão nesta página.
</p>

<div class="pg-card" style="padding:1.25rem; margin-bottom:1rem; max-width:640px;">
    <h4 class="gold" style="margin-top:0;">Baixar meus dados</h4>
    <p class="pg-muted" style="margin-bottom:.75rem;">
        Gera um arquivo <code>.json</code> com <strong>tudo</strong> o que a loja mantém sobre você:
        conta de login, cadastro (incluindo CPF/CNPJ e telefone), agenda de endereços,
        pedidos com itens e valores, notas fiscais emitidas no seu nome, aluguéis,
        trocas e propostas de venda.
    </p>
    <form action="Account/Manage/DownloadPersonalData" method="post">
        <AntiforgeryToken />
        <button class="pg-btn pg-btn-gold" type="submit">Baixar meus dados</button>
    </form>
</div>

<div class="pg-card" style="padding:1.25rem; max-width:640px; border-color:#7a3b3b;">
    <h4 style="margin-top:0; color:#ff8a8a;">Encerrar minha conta</h4>
    <p class="pg-muted" style="margin-bottom:.75rem;">
        Seus dados pessoais são apagados e a conta é encerrada — <strong>sem volta</strong>.
        Pedidos e notas fiscais já emitidos permanecem no sistema <strong>sem identificar você</strong>,
        porque a legislação fiscal obriga a loja a guardar esses documentos por 5 anos.
    </p>
    <a href="Account/Manage/DeletePersonalData" class="pg-btn pg-btn-ghost">Encerrar minha conta</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
