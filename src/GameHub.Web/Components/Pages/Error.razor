@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Diagnostics
@inject ILogger<Error> Logger

<PageTitle>Algo deu errado — GameHub</PageTitle>

@* PÁGINA DE ERRO PARA O USUÁRIO — não para o programador.
   O que ela NÃO mostra é tão importante quanto o que mostra: nada de stack trace, nome de
   classe, caminho de arquivo, versão de framework ou mensagem de exceção. Isso é
   RECONHECIMENTO gratuito para quem procura falhas: o stack trace revela a estrutura
   interna, as bibliotecas usadas e as versões — e versão conhecida é vulnerabilidade
   conhecida. O detalhe vai para o LOG do servidor; o usuário recebe um código. *@

<div style="max-width:560px; margin:3rem auto; text-align:center;">
    <div style="font-size:3rem;">🎮💥</div>
    <h1>Algo deu <span class="gold">errado</span></h1>

    <p class="pg-muted" style="margin-top:1rem;">
        Tivemos um problema ao processar sua solicitação. O erro foi registrado e será
        analisado — nenhum dado seu foi perdido.
    </p>

    @if (!string.IsNullOrEmpty(CodigoDoErro))
    {
        @* O CÓDIGO é a ponte entre o usuário e o log: ele informa isto ao suporte, e o
           suporte encontra a ocorrência exata sem que o erro tenha sido exposto na tela. *@
        <div class="pg-card" style="padding:1rem; margin:1.5rem 0;">
            <div class="pg-muted" style="font-size:.8rem;">CÓDIGO DA OCORRÊNCIA</div>
            <code style="font-size:1.05rem;">@CodigoDoErro</code>
            <div class="pg-muted" style="font-size:.8rem; margin-top:.5rem;">
                Informe este código se precisar falar com o suporte.
            </div>
        </div>
    }

    <div style="display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap;">
        <a class="pg-btn pg-btn-gold" href="/">Voltar à loja</a>
        <a class="pg-btn pg-btn-outline" href="meus-pedidos">Meus pedidos</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? CodigoDoErro { get; set; }

    protected override void OnInitialized()
    {
        // Activity.Current?.Id é o id de rastreamento distribuído (o mesmo que aparece nos
        // logs estruturados e, na Fase 17, no OpenTelemetry). TraceIdentifier é o reserva.
        CodigoDoErro = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

        // REGISTRA o detalhe no servidor. O usuário vê só o código; nós vemos a exceção
        // inteira, ligada a esse mesmo código — é o que torna o código útil no suporte.
        var detalhe = HttpContext?.Features.Get<IExceptionHandlerPathFeature>();
        if (detalhe?.Error is not null)
        {
            Logger.LogError(detalhe.Error,
                "Erro não tratado em {Caminho}. Código informado ao usuário: {Codigo}",
                detalhe.Path, CodigoDoErro);
        }
    }
}
