@page "/minha-conta/dados"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Security.Claims
@using GameHub.Domain.Enums
@using GameHub.Domain.Services
@using Microsoft.AspNetCore.Identity
@using GameHub.Web.Data
@using GameHub.Web.Autorizacao
@inject IClienteService ClienteService
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Dados Fiscais — GameHub</PageTitle>

<div class="pg-section-head">
    <h1>Meus <span class="gold">Dados Fiscais</span></h1>
</div>

@if (mensagem is not null)
{
    <div class="pg-toast">@mensagem</div>
}

<div style="max-width:520px;">
    <p class="pg-muted">
        O CPF/CNPJ identifica você como <strong>destinatário na nota fiscal</strong> —
        sem ele, a emissão é rejeitada (como em qualquer loja de verdade).
    </p>

    <label>Tipo de pessoa</label>
    <select class="pg-input" @bind="tipoPessoa">
        <option value="@TipoPessoa.Fisica">Pessoa física (CPF)</option>
        <option value="@TipoPessoa.Juridica">Pessoa jurídica (CNPJ)</option>
    </select>

    <label>@(tipoPessoa == TipoPessoa.Fisica ? "CPF" : "CNPJ")</label>
    <input class="pg-input" @bind="cpfCnpj"
           placeholder="@(tipoPessoa == TipoPessoa.Fisica ? "000.000.000-00" : "00.000.000/0000-00")" />

    <label>Telefone (opcional)</label>
    <input class="pg-input" @bind="telefone" placeholder="(12) 99999-9999" />

    <button class="pg-btn pg-btn-gold" style="margin-top:1rem;" @onclick="Salvar" disabled="@ocupado">
        Salvar dados
    </button>

    @if (!string.IsNullOrEmpty(cpfCnpjAtual))
    {
        <p class="pg-muted" style="margin-top:1rem;">
            Cadastrado: <strong>@ValidadorCpfCnpj.Formatar(cpfCnpjAtual)</strong>
            — agora dá pra <a href="meus-pedidos">reemitir notas rejeitadas</a>.
        </p>
    }

    @* ---- DATA DE NASCIMENTO (classificação indicativa · Fase 11 · P4) ----
       Formulário POST separado, e não o botão interativo acima: salvar a data precisa
       RENOVAR O COOKIE de autenticação (o claim é um snapshot do login), e cookie só se
       escreve numa resposta HTTP — o circuito do Blazor não tem uma. *@
    <hr style="margin:2rem 0; border-color:var(--pg-border);" />

    <h2 class="gold" style="font-size:1.1rem;">Data de nascimento</h2>
    <p class="pg-muted">
        Usamos para respeitar a <strong>classificação indicativa</strong> dos jogos —
        títulos com restrição de idade só ficam disponíveis para quem atingiu a faixa.
    </p>

    @if (nascimentoSalvo)
    {
        <div class="pg-toast">✅ Data de nascimento salva.</div>
    }
    @if (erroNascimento)
    {
        <div class="pg-toast">⚠️ Data inválida. Confira o dia, mês e ano.</div>
    }

    <form action="minha-conta/nascimento" method="post">
        <AntiforgeryToken />
        <input class="pg-input" type="date" name="dataNascimento" value="@dataNascimentoAtual" required />
        <button class="pg-btn pg-btn-outline" style="margin-top:.75rem;" type="submit">
            Salvar data de nascimento
        </button>
    </form>

    @* A mensagem só aparece quando DIZ ALGO ÚTIL.
       Para quem já passou da faixa máxima (18), não existe restrição — informar "títulos até
       31 anos estão liberados" seria ruído: um número que não corresponde a nada no catálogo.
       Para menores, sim: saber QUAIS faixas estão bloqueadas é acionável. *@
    @if (idadeAtual is int idade)
    {
        <p class="pg-muted" style="margin-top:.75rem;">
            @if (FaixasBloqueadas(idade) is { Count: > 0 } bloqueadas)
            {
                <text>
                    Você tem <strong>@idade anos</strong> — títulos
                    <strong>@string.Join(", ", bloqueadas.Select(f => $"{f}+"))</strong>
                    ficam indisponíveis.
                </text>
            }
            else
            {
                <text>Data cadastrada — <strong>nenhum título</strong> tem restrição de idade para você.</text>
            }
        </p>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string? userId;
    private string? nome;
    private TipoPessoa tipoPessoa = TipoPessoa.Fisica;
    private string cpfCnpj = "";
    private string telefone = "";
    private string? cpfCnpjAtual;
    private string? mensagem;
    private bool ocupado;
    private string? dataNascimentoAtual;
    private int? idadeAtual;

    // Lidos da URL: o endpoint redireciona com ?nascimentoSalvo=1 ou ?erroNascimento=1.
    // (É como um POST tradicional devolve o resultado sem repostar ao recarregar.)
    [SupplyParameterFromQuery] private bool nascimentoSalvo { get; set; }
    [SupplyParameterFromQuery] private bool erroNascimento { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        userId = user?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        nome = user?.Identity?.Name;
        if (string.IsNullOrEmpty(userId)) return;

        var appUser = await UserManager.FindByIdAsync(userId);
        if (appUser?.DataNascimento is DateOnly nascimento)
        {
            dataNascimentoAtual = nascimento.ToString("yyyy-MM-dd");   // formato do <input type=date>
            idadeAtual = ClassificacaoIndicativaHandler.CalcularIdade(
                nascimento, DateOnly.FromDateTime(DateTime.Today));
        }

        var cliente = await ClienteService.ObterAsync(userId);
        if (cliente is not null)
        {
            tipoPessoa = cliente.TipoPessoa;
            cpfCnpjAtual = cliente.CpfCnpj;
            cpfCnpj = ValidadorCpfCnpj.Formatar(cliente.CpfCnpj);
            telefone = cliente.Telefone ?? "";
        }
    }

    /// <summary>
    /// Faixas do catálogo que a idade NÃO alcança. Derivadas do próprio enum — nada de
    /// "18" escrito à mão: se o Ministério da Justiça criar uma faixa nova, basta
    /// acrescentar ao enum e esta tela acompanha.
    /// </summary>
    private static List<int> FaixasBloqueadas(int idade) =>
        Enum.GetValues<ClassificacaoIndicativa>()
            .Select(c => (int)c)
            .Where(faixa => faixa > idade)
            .OrderBy(faixa => faixa)
            .ToList();

    private async Task Salvar()
    {
        mensagem = null;
        if (string.IsNullOrEmpty(userId)) return;

        // Cortesia de UX: valida na tela antes (a validação QUE VALE é a do servidor).
        var digitos = ValidadorCpfCnpj.SoDigitos(cpfCnpj);
        var valido = tipoPessoa == TipoPessoa.Fisica
            ? ValidadorCpfCnpj.ValidarCpf(digitos)
            : ValidadorCpfCnpj.ValidarCnpj(digitos);
        if (!valido)
        {
            mensagem = tipoPessoa == TipoPessoa.Fisica
                ? "⚠️ CPF inválido — os dígitos verificadores não batem."
                : "⚠️ CNPJ inválido — os dígitos verificadores não batem.";
            return;
        }

        ocupado = true;
        try
        {
            await ClienteService.SalvarDadosFiscaisAsync(userId, nome ?? "Cliente", tipoPessoa, digitos, telefone);
            cpfCnpjAtual = digitos;
            mensagem = "✅ Dados fiscais salvos.";
        }
        catch (Exception ex)
        {
            mensagem = "⚠️ " + ex.Message;
        }
        finally { ocupado = false; }
    }
}
