@page "/admin/frete"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using GameHub.Domain.Entities
@using GameHub.Infrastructure.Data
@inject GameHubDbContext Db

<PageTitle>Frete — Admin GameHub</PageTitle>

<div class="pg-section-head">
    <h1>Tabela de <span class="gold">Frete</span></h1>
    <a class="pg-btn pg-btn-outline" href="admin/dashboard">← Dashboard</a>
</div>

@if (mensagem is not null)
{
    <div class="pg-toast">@mensagem</div>
}

<p class="pg-muted" style="max-width:760px;">
    A <strong>fórmula</strong> vive no código (regra estável); os <strong>valores</strong> vivem aqui
    (dado comercial, muda sem deploy):
    <code>valor = (base × fator da região) + (por item × itens)</code> ·
    <code>prazo = base + dias extras da região</code>.
    A região vem do <strong>1º dígito do CEP</strong> (regra dos Correios).
</p>

@* ---- Parâmetros globais ---- *@
@if (config is not null)
{
    <h2 class="gold">Parâmetros</h2>
    <div style="display:flex; gap:1rem; flex-wrap:wrap; align-items:flex-end; margin-bottom:1.5rem;">
        <div><label>Valor base (R$)</label>
            <input class="pg-input" type="number" step="0.01" min="0" @bind="config.ValorBase" style="width:130px;" /></div>
        <div><label>Por item (R$)</label>
            <input class="pg-input" type="number" step="0.01" min="0" @bind="config.ValorPorItem" style="width:130px;" /></div>
        <div><label>Prazo base (dias)</label>
            <input class="pg-input" type="number" min="0" @bind="config.PrazoBaseDias" style="width:130px;" /></div>
        <div><label>Frete grátis acima de (R$ — 0 desliga)</label>
            <input class="pg-input" type="number" step="0.01" min="0" @bind="config.FreteGratisAcimaDe" style="width:200px;" /></div>
        <button class="pg-btn pg-btn-gold" @onclick="SalvarConfig" disabled="@ocupado">Salvar parâmetros</button>
    </div>
}

@* ---- Regiões ---- *@
<h2 class="gold">Regiões</h2>
@if (regioes is null)
{
    <p class="pg-muted">Carregando...</p>
}
else
{
    <table class="pg-table" style="max-width:860px;">
        <thead>
            <tr><th>CEP começa com</th><th>Região</th><th>Fator</th><th>Dias extras</th><th>Entrega?</th><th>Exemplo</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var r in regioes)
            {
                <tr>
                    <td><strong>@r.DigitoCep</strong></td>
                    <td><input class="pg-input" @bind="r.Nome" style="min-width:180px;" /></td>
                    <td><input class="pg-input" type="number" step="0.1" min="0" @bind="r.Fator" style="width:90px;" /></td>
                    <td><input class="pg-input" type="number" min="0" @bind="r.DiasExtras" style="width:90px;" /></td>
                    <td><input type="checkbox" @bind="r.Ativo" /></td>
                    <td class="pg-muted">
                        @* Prévia do cálculo com 1 item, para o admin conferir o efeito. *@
                        R$ @((config is null ? 0 : Math.Round(config.ValorBase * r.Fator + config.ValorPorItem, 2)).ToString("N2"))
                        · @((config?.PrazoBaseDias ?? 0) + r.DiasExtras) dias
                    </td>
                    <td style="text-align:right;">
                        <button class="pg-btn pg-btn-ghost" @onclick="() => SalvarRegiao(r)" disabled="@ocupado">Salvar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<RegiaoFrete>? regioes;
    private ConfiguracaoFrete? config;
    private string? mensagem;
    private bool ocupado;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        // COM tracking (vamos editar e salvar) — o oposto das telas de leitura.
        regioes = await Db.RegioesFrete.OrderBy(r => r.DigitoCep).ToListAsync();
        config = await Db.ConfiguracoesFrete.FirstOrDefaultAsync();
    }

    private async Task SalvarConfig()
    {
        mensagem = null;
        ocupado = true;
        try
        {
            if (config is null) return;
            if (config.ValorBase < 0 || config.ValorPorItem < 0) { mensagem = "⚠️ Valores não podem ser negativos."; return; }
            await Db.SaveChangesAsync();   // a auditoria carimba AtualizadoPor sozinha
            mensagem = "✅ Parâmetros salvos — o checkout já usa os valores novos.";
        }
        catch (Exception ex) { mensagem = "⚠️ " + ex.Message; }
        finally { ocupado = false; }
    }

    private async Task SalvarRegiao(RegiaoFrete r)
    {
        mensagem = null;
        ocupado = true;
        try
        {
            if (r.Fator < 0) { mensagem = "⚠️ O fator não pode ser negativo."; return; }
            if (string.IsNullOrWhiteSpace(r.Nome)) { mensagem = "⚠️ Dê um nome à região."; return; }
            await Db.SaveChangesAsync();
            mensagem = $"✅ Região \"{r.Nome}\" salva.";
        }
        catch (Exception ex) { mensagem = "⚠️ " + ex.Message; }
        finally { ocupado = false; }
    }
}
