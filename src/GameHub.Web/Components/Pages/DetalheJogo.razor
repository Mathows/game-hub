@page "/jogo/{Id:int}"
@rendermode InteractiveServer
@using GameHub.Domain.Enums
@using GameHub.Web.Autorizacao
@using Microsoft.AspNetCore.Authorization
@inject IJogoRepository JogoRepo
@inject CarrinhoService Carrinho
@inject IAuthorizationService Autorizacao

@* @rendermode InteractiveServer: esta página deixa de ser HTML estático e passa a rodar num
   CIRCUITO (conexão SignalR). É isso que permite os botões reagirem ao clique em C#.
   Sem esse modo, um @onclick não teria como chamar o servidor. *@

<PageTitle>@(jogo?.Titulo ?? "Jogo") — GameHub</PageTitle>

@if (jogo is null)
{
    <div class="pg-empty">Jogo não encontrado. <a href="catalogo">Voltar ao catálogo</a></div>
}
else
{
    <a class="pg-muted" href="catalogo">← Voltar ao catálogo</a>

    <div class="pg-detail">
        <div class="pg-detail-cover">
            @if (!string.IsNullOrEmpty(jogo.UrlFoto))
            {
                <img src="@jogo.UrlFoto" alt="@jogo.Titulo" />
            }
            else
            {
                <svg viewBox="0 0 24 24" width="48" height="48" fill="currentColor" aria-hidden="true"><path d="M7.9 5h8.2c2.6 0 4.8 1.9 5.1 4.5l.8 5.8a3.1 3.1 0 0 1-5.4 2.4l-1.8-2a2 2 0 0 0-1.5-.7h-2.6a2 2 0 0 0-1.5.7l-1.8 2a3.1 3.1 0 0 1-5.4-2.4l.8-5.8A5.2 5.2 0 0 1 7.9 5Zm.1 3a1 1 0 0 0-1 1v.8h-.8a1 1 0 1 0 0 2H7v.7a1 1 0 1 0 2 0v-.7h.8a1 1 0 1 0 0-2H9V9a1 1 0 0 0-1-1Zm7.3.3a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2Zm2.5 2.5a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2Z"/></svg>
            }
        </div>

        <div>
            <h1>@jogo.Titulo</h1>
            <p class="pg-muted">
                @jogo.Plataforma?.Nome • @jogo.Genero?.Nome • @jogo.Condicao
                <span class="pg-classificacao pg-cl-@((int)jogo.Classificacao)"
                      title="Classificação indicativa: @RotuloClassificacao(jogo.Classificacao)">
                    @(jogo.Classificacao == ClassificacaoIndicativa.Livre ? "L" : ((int)jogo.Classificacao).ToString())
                </span>
            </p>

            <p>@(string.IsNullOrWhiteSpace(jogo.Descricao) ? "Sem descrição cadastrada." : jogo.Descricao)</p>

            @{ var promocao = jogo.PromocaoVigente(DateTime.Now); }
            @if (promocao is not null)
            {
                <div class="pg-price-lg">
                    <s style="opacity:.5;font-size:.7em;">R$ @jogo.PrecoVenda.ToString("N2")</s>
                    R$ @promocao.PrecoPromocional.ToString("N2")
                    <span class="pg-badge" style="position:static;background:#b32121;color:#fff;border-color:#b32121;">@promocao.Nome</span>
                </div>
            }
            else
            {
                <div class="pg-price-lg">R$ @jogo.PrecoVenda.ToString("N2")</div>
            }
            <p class="pg-muted">
                Aluguel: R$ @jogo.PrecoAluguelDia.ToString("N2") / dia • Em estoque: @jogo.QuantidadeEstoque
            </p>

            @if (!podeComprar)
            {
                @* BLOQUEIO POR CLASSIFICAÇÃO INDICATIVA (Fase 11 · P4).
                   Some com os botões de compra — a decisão veio da policy, não de um if
                   com a regra escrita aqui dentro. *@
                <div class="pg-bloqueio-idade">
                    <strong>Jogo classificado para @((int)jogo.Classificacao) anos ou mais.</strong>
                    <p class="pg-muted" style="margin:.5rem 0 0;">
                        @motivoBloqueio
                    </p>
                </div>
            }
            else if (jogo.QuantidadeEstoque > 0)
            {
                <div class="pg-buy-box">
                    @* COMPRAR *@
                    <button class="pg-btn pg-btn-gold" @onclick="Comprar">
                        🛒 Adicionar para comprar
                    </button>

                    @* ALUGAR: escolhe quantos dias; o valor é preço/dia × dias *@
                    <div class="pg-rent-row">
                        <label class="pg-muted">Alugar por</label>
                        <input class="pg-input pg-input-sm" type="number" min="1" max="30" @bind="diasAluguel" />
                        <span class="pg-muted">dia(s) — R$ @((jogo.PrecoAluguelDia * diasAluguel).ToString("N2"))</span>
                        <button class="pg-btn pg-btn-outline" @onclick="Alugar">Adicionar aluguel</button>
                    </div>
                </div>

                @if (mensagem is not null)
                {
                    <div class="pg-toast">
                        ✅ @mensagem — <a href="carrinho">ver carrinho</a>
                    </div>
                }
            }
            else
            {
                <p class="pg-empty">Sem estoque no momento.</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Jogo? jogo;
    private int diasAluguel = 3;      // valor inicial do campo de dias
    private string? mensagem;
    private bool podeComprar = true;
    private string motivoBloqueio = "";

    protected override async Task OnParametersSetAsync()
    {
        jogo = await JogoRepo.ObterPorIdAsync(Id);
        if (jogo is null) return;

        await VerificarClassificacaoAsync();
    }

    /// <summary>
    /// Pergunta à POLICY se este usuário pode comprar este jogo. Repare que a página não
    /// sabe a regra: não há comparação de idade aqui. Ela só pergunta e obedece — se
    /// amanhã a regra mudar (ex.: aceitar autorização de responsável), esta tela não muda.
    /// </summary>
    private async Task VerificarClassificacaoAsync()
    {
        var user = AuthState is null
            ? new System.Security.Claims.ClaimsPrincipal()
            : (await AuthState).User;

        // AuthorizeAsync com RECURSO: passamos o jogo. É o que permite a mesma policy
        // aprovar um jogo Livre e recusar um 18+ para a mesma pessoa.
        var resultado = await Autorizacao.AuthorizeAsync(user, jogo, Policies.RespeitaClassificacao);
        podeComprar = resultado.Succeeded;

        if (podeComprar) return;

        // A MENSAGEM depende do motivo — e isso é uma decisão de UX, não de segurança:
        // quem não informou a data precisa saber que pode resolver; quem é menor de idade
        // precisa entender que não há o que resolver.
        var temData = user.FindFirst(ClassificacaoIndicativaHandler.ClaimDataNascimento) is not null;
        motivoBloqueio = user.Identity?.IsAuthenticated != true
            ? "Entre na sua conta para confirmarmos sua idade."
            : temData
                ? "Sua data de nascimento indica que você não atingiu a idade mínima para este título."
                : "Informe sua data de nascimento em \"Minha conta → Dados fiscais\" para liberar títulos com restrição de idade.";
    }

    private static string RotuloClassificacao(ClassificacaoIndicativa c) =>
        c == ClassificacaoIndicativa.Livre ? "Livre para todos os públicos" : $"Não recomendado para menores de {(int)c} anos";

    private void Comprar()
    {
        if (jogo is null) return;
        Carrinho.AdicionarCompra(jogo);
        mensagem = $"\"{jogo.Titulo}\" adicionado para compra";
    }

    private void Alugar()
    {
        if (jogo is null) return;
        Carrinho.AdicionarAluguel(jogo, diasAluguel);
        mensagem = $"\"{jogo.Titulo}\" adicionado para aluguel ({diasAluguel} dia(s))";
    }
}
